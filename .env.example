# development | staging | production | test
APP_ENV=development

# Endereço de escuta do processo. Em container, mantenha 0.0.0.0.
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# true | false. Sem valor: ligado fora de production.
OPENAPI_ENABLED=true

# WorkOS AuthKit. Os três são obrigatórios em staging e production.
WORKOS_ISSUER=
WORKOS_AUDIENCE=
WORKOS_JWKS_URL=

# PostgreSQL. Obrigatório em staging e production.
# A API aplica as migrations ao subir e atende o prontuário com o papel implante_app.
DATABASE_URL=postgres://implante:implante@127.0.0.1:5432/implante_flow

# Bucket de fotos e certificados. Região padrão sa-east-1.
# Staging e production deixam endpoint e chaves vazios: a API usa o S3 do ambiente.
# O compose de desenvolvimento publica MinIO em 127.0.0.1:9000 com o bucket implante-flow,
# usuário implante e senha implante-dev-key.
S3_BUCKET=
S3_REGION=sa-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Origens do navegador, separadas por vírgula. Vazio desliga CORS.
# O app móvel não depende desta lista.
CORS_ORIGINS=
