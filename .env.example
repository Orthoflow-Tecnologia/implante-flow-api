# development | staging | production | test
APP_ENV=development

# Endereço de escuta do processo. Em container, mantenha 0.0.0.0.
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# true | false. Sem valor: ligado fora de production.
OPENAPI_ENABLED=true

# PostgreSQL. Obrigatório em staging e production.
# A API aplica as migrations ao subir e atende o prontuário com o papel implante_app.
DATABASE_URL=postgres://implante:implante@127.0.0.1:5432/implante_flow

# Origens do navegador, separadas por vírgula. Vazio desliga CORS.
# O app móvel não depende desta lista.
CORS_ORIGINS=
